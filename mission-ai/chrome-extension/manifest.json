{
  "manifest_version": 3,
  "name": "Mission AI Browser Bridge",
  "version": "0.3.0",
  "description": "Lets the local Mission AI companion work with the active Chrome tab.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mission AI Browser Bridge",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116",
  "key": ""
}
