{
  "name": "mission-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test *.test.js ../../plugin/mission-ai-budget/scripts/*.test.mjs",
    "check": "for f in *.js; do node --check \"$f\"; done && bash -n ../code-api/build.sh ../code-api/start.sh ../code-worker/install-macos.sh ../code-worker/uninstall-macos.sh",
    "postinstall": "npm run check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "express": "^5.1.0",
    "mongoose": "^8.24.1",
    "ws": "^8.18.3",
    "zod": "^4.6.5",
    "@modelcontextprotocol/client": "^2.1.0"
  }
}
