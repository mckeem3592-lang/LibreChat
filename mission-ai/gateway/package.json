{
  "name": "mission-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:native": "tsc -p tsconfig.native.json",
    "typecheck:native": "tsc -p tsconfig.native.json --noEmit",
    "pretest": "npm run build:native",
    "start": "node server.js",
    "test": "node --test *.test.js ../companion/*.test.js ../chrome-extension/*.test.js ../code-worker/*.test.mjs ../../plugin/mission-ai-budget/scripts/*.test.mjs",
    "test:integration": "node --test *.integration.mjs",
    "check": "for f in *.js ../companion/*.js ../chrome-extension/*.js; do node --check \"$f\"; done && bash -n ../acceptance/check-macos.sh ../companion/install-macos.sh ../companion/pair-macos.sh ../code-api/build.sh ../code-api/start.sh ../code-worker/install-macos.sh ../code-worker/uninstall-macos.sh",
    "postinstall": "npm run check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "express": "^5.1.0",
    "mongoose": "^8.24.1",
    "typescript": "5.9.3",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server-core": "11.0.1",
    "openai": "6.41.0"
  }
}
