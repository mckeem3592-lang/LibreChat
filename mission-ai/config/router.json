{
  "budget": {
    "targetUsd": 100,
    "economyUsd": 125,
    "hardUsd": 175
  },
  "routes": {
    "economy": {
      "provider": "anthropic",
      "defaultModel": "claude-sonnet-5-5",
      "modelEnv": "MISSION_AI_MODEL_ECONOMY",
      "premium": false
    },
    "primary": {
      "provider": "anthropic",
      "defaultModel": "claude-sonnet-5-5",
      "modelEnv": "MISSION_AI_MODEL_PRIMARY",
      "premium": false
    },
    "coding": {
      "provider": "anthropic",
      "defaultModel": "claude-sonnet-5-5",
      "modelEnv": "MISSION_AI_MODEL_CODING",
      "premium": false
    },
    "reasoning": {
      "provider": "anthropic",
      "defaultModel": "claude-sonnet-5-5",
      "modelEnv": "MISSION_AI_MODEL_REASONING",
      "premium": false
    },
    "research": {
      "provider": "anthropic",
      "defaultModel": "claude-sonnet-5-5",
      "modelEnv": "MISSION_AI_MODEL_RESEARCH",
      "premium": false
    },
    "computer": {
      "provider": "anthropic",
      "defaultModel": "claude-sonnet-5-5",
      "modelEnv": "MISSION_AI_MODEL_COMPUTER",
      "premium": false
