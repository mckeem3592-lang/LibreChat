# Strict offline text baseline. Do not enable paid gates during configuration.
MISSION_AI_NATIVE_ENABLED=false
MISSION_AI_DELEGATION_ENABLED=false
MISSION_AI_SEARCH_ENABLED=false
# Search additionally requires a private key-bound PAYG-off check less than
# 24 hours old in the same UTC month. Do not fill these without verification.
# MISSION_AI_TAVILY_PAYG_OFF_VERIFIED_AT=
# MISSION_AI_TAVILY_KEY_SHA256=
MISSION_AI_NATIVE_MODELS=claude-sonnet-5-5
MISSION_AI_MODEL_ECONOMY=claude-sonnet-5-5
MISSION_AI_MODEL_PRIMARY=claude-sonnet-5-5
MISSION_AI_MODEL_REASONING=claude-sonnet-5-5
MISSION_AI_MODEL_COMPUTER=claude-sonnet-5-5
MISSION_AI_MODEL_CODING=claude-sonnet-5-5
MISSION_AI_MODEL_RESEARCH=claude-sonnet-5-5
MISSION_AI_MODEL_IMAGE=gemini-3.1-flash-image
# Set TAVILY_API_KEY only in private Render settings; never commit its value.
