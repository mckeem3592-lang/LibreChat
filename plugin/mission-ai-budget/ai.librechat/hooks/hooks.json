{
  "description": "Check Mission AI monthly spend before each user prompt.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/budget-guard.mjs\"",
            "timeout": 10,
            "allowedEnvVars": [
              "MONGO_URI",
              "MISSION_AI_BUDGET_TARGET_USD",
              "MISSION_AI_BUDGET_ECONOMY_USD",
              "MISSION_AI_BUDGET_HARD_USD",
              "MISSION_AI_BUDGET_TIMEZONE"
            ]
          }
        ]
      }
    ]
  }
}
